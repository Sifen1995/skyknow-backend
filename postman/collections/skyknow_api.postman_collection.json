{
  "info": {
    "_postman_id": "a90f8452-f32a-4bc4-9d10-3849182312ab",
    "name": "SkyKnow Enterprise API Integration Suite",
    "description": "End-to-end automated Postman/Newman integration test suite for the SkyKnow Multi-Tenant Knowledge Platform.\n\nCovers:\n1. Health Check\n2. Platform Admin Authentication & Token Rotation\n3. Tenant Lifecycle (Provisioning, Logo Upload, Dynamic Schema Creation)\n4. Public Tenant Branding (Header & Path Param Resolution)\n5. Tenant Identity Authentication (Admin Role Resolution via Redis Cache, Refresh, Logout)\n6. Automated Teardown & Schema Cleanup (Dropping Schema, Deleting Assets, Clearing Redis)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Health Check",
      "item": [
        {
          "name": "Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Health status is ok\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql(\"ok\");",
                  "    pm.expect(jsonData.version).to.be.a(\"string\");",
                  "    pm.expect(jsonData.environment).to.be.a(\"string\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Verifies that the SkyKnow backend application is live, responsive, and reports healthy status."
          },
          "response": []
        }
      ]
    },
    {
      "name": "02 Platform Admin",
      "item": [
        {
          "name": "01 Platform Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response contains valid platform tokens and admin profile\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    if (jsonData.access_token) {",
                  "        pm.environment.set(\"platform_access_token\", jsonData.access_token);",
                  "        pm.environment.set(\"platform_refresh_token\", jsonData.refresh_token);",
                  "        pm.environment.set(\"platform_family_id\", jsonData.family_id);",
                  "        pm.environment.set(\"platform_generation\", jsonData.current_generation);",
                  "    }",
                  "    pm.expect(jsonData).to.have.property(\"access_token\");",
                  "    pm.expect(jsonData).to.have.property(\"refresh_token\");",
                  "    pm.expect(jsonData).to.have.property(\"family_id\");",
                  "    pm.expect(jsonData).to.have.property(\"current_generation\");",
                  "    pm.expect(jsonData.token_type).to.eql(\"bearer\");",
                  "    pm.expect(jsonData.admin.email).to.eql(pm.environment.get(\"super_admin_email\"));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Origin",
                "value": "{{origin}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{super_admin_email}}\",\n  \"password\": \"{{super_admin_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/platform-admin/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "platform-admin",
                "login"
              ]
            },
            "description": "Authenticates the platform super-super admin, extracting access token, refresh token family, and generation."
          },
          "response": []
        },
        {
          "name": "02 Platform Admin Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Refresh token family rotated to generation 2\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    if (jsonData.access_token) {",
                  "        pm.environment.set(\"platform_access_token\", jsonData.access_token);",
                  "        pm.environment.set(\"platform_refresh_token\", jsonData.refresh_token);",
                  "        pm.environment.set(\"platform_generation\", jsonData.current_generation);",
                  "    }",
                  "    pm.expect(jsonData).to.have.property(\"access_token\");",
                  "    pm.expect(jsonData).to.have.property(\"refresh_token\");",
                  "    pm.expect(jsonData.family_id).to.eql(pm.environment.get(\"platform_family_id\"));",
                  "    pm.expect(jsonData.current_generation).to.eql(2);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Origin",
                "value": "{{origin}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"family_id\": \"{{platform_family_id}}\",\n  \"count\": {{platform_generation}},\n  \"refresh_token\": \"{{platform_refresh_token}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/platform-admin/refresh",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "platform-admin",
                "refresh"
              ]
            },
            "description": "Rotates platform admin refresh token atomically and increments the family generation counter."
          },
          "response": []
        }
      ]
    },
