        {
          "name": "02 Provision Tenant",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Tenant provisioned with dedicated schema and admin\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    if (jsonData.tenant_id) {",
                  "        pm.environment.set(\"tenant_id\", jsonData.tenant_id);",
                  "    }",
                  "    pm.expect(jsonData.subdomain).to.eql(pm.environment.get(\"tenant_subdomain\"));",
                  "    pm.expect(jsonData.admin_email).to.eql(pm.environment.get(\"tenant_admin_email\"));",
                  "    pm.expect(jsonData.schema_name).to.eql(\"tenant_\" + pm.environment.get(\"tenant_subdomain\"));",
                  "    pm.expect(jsonData.hosting_mode).to.eql(\"shared\");",
                  "    pm.expect(jsonData.tenant_id).to.be.a(\"string\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Origin",
                "value": "{{origin}}",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{platform_access_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "subdomain",
                  "value": "{{tenant_subdomain}}",
                  "type": "text"
                },
                {
                  "key": "admin_email",
                  "value": "{{tenant_admin_email}}",
                  "type": "text"
                },
                {
                  "key": "admin_name",
                  "value": "{{tenant_admin_name}}",
                  "type": "text"
                },
                {
                  "key": "name",
                  "value": "{{tenant_name}}",
                  "type": "text"
                },
                {
                  "key": "temporary_password",
                  "value": "{{tenant_admin_password}}",
                  "type": "text"
                },
                {
                  "key": "hosting_mode",
                  "value": "shared",
                  "type": "text"
                },
                {
                  "key": "primary_color",
                  "value": "{{tenant_primary_color}}",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/v1/platform-admin/tenants",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "platform-admin",
                "tenants"
              ]
            },
            "description": "Provisions a new tenant, dynamically creating an isolated PostgreSQL schema, seeding roles, and creating the tenant admin."
          },
          "response": []
        },
