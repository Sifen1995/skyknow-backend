    {
      "name": "05 Tenant Identity & Role Auth",
      "item": [
        {
          "name": "01 Tenant Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Tenant Admin authenticated with role determined from Redis-cached schema roles\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    if (jsonData.access_token) {",
                  "        pm.environment.set(\"tenant_access_token\", jsonData.access_token);",
                  "        pm.environment.set(\"tenant_refresh_token\", jsonData.refresh_token);",
                  "        pm.environment.set(\"tenant_family_id\", jsonData.family_id);",
                  "        pm.environment.set(\"tenant_generation\", jsonData.current_generation);",
                  "    }",
                  "    pm.expect(jsonData).to.have.property(\"access_token\");",
                  "    pm.expect(jsonData).to.have.property(\"refresh_token\");",
                  "    pm.expect(jsonData).to.have.property(\"family_id\");",
                  "    pm.expect(jsonData.token_type).to.eql(\"bearer\");",
                  "    pm.expect(jsonData.user.email).to.eql(pm.environment.get(\"tenant_admin_email\"));",
                  "    pm.expect(jsonData.user.is_admin).to.be.true;",
                  "    pm.expect(jsonData.user.role.toLowerCase()).to.eql(\"admin\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Origin",
                "value": "{{origin}}",
                "type": "text"
              },
              {
                "key": "X-Tenant-Subdomain",
                "value": "{{tenant_subdomain}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{tenant_admin_email}}\",\n  \"password\": \"{{tenant_admin_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/identity/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "identity",
                "login"
              ]
            },
            "description": "Authenticates tenant user/admin against tenant schema, resolving admin privileges via role_id and Redis cache."
          },
          "response": []
        },
