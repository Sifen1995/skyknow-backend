              ],
              "path": [
                "api",
                "v1",
                "platform-admin",
                "tenants",
                "{{tenant_subdomain}}"
              ]
            },
            "description": "Completely deletes the test tenant: drops schema CASCADE, deletes row in public.tenants, removes disk assets, and clears Redis cache."
          },
          "response": []
        },
        {
          "name": "02 Verify Tenant Cleanup (404 Not Found)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 404 Not Found\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
