              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Tenant deletion confirmation received\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.subdomain).to.eql(pm.environment.get(\"tenant_subdomain\"));",
                  "    pm.expect(jsonData.message).to.include(\"successfully deleted\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Origin",
                "value": "{{origin}}",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{platform_access_token}}",
